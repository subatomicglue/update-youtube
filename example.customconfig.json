{
  "archiveDirectory": "/path/to/private/video-archive",
  "cookies": {
    "macos": null,
    "windows": null,
    "linux": null
  },
  "targets": [
    {
      "enable": 0,
      "directory": "AnotherChannel/Videos",
      "url": "https://www.youtube.com/@ANOTHER_CHANNEL/videos",
      "namingProfile": "dated-with-id"
    }
  ],
  "postSteps": [
    {
      "name": "Deploy transcripts",
      "enabled": false,
      "command": "bash -c 'scp -C \"${archiveDir}/Transcripts-YouTube/\"*.srt.json \"user@example-host:/path/to/transcripts/\"'",
      "cwd": ".",
      "platforms": ["macos", "linux"]
    }
  ]
}
