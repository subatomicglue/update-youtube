{
  "name": "update-youtube",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-platform yt-dlp archive runner",
  "bin": {
    "update-youtube": "update-youtube.js",
    "generate-transcript": "generate-transcript.js",
    "render-transcript": "render-transcript.js"
  },
  "scripts": {
    "help": "node scripts/npm-help.js",
    "archive": "node update-youtube.js",
    "simulate": "node update-youtube.js --simulate",
    "test": "node test/run-tests.js",
    "build": "node scripts/check-node-version.js && node scripts/build.js"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.6.0",
    "esbuild": "^0.28.2"
  },
  "pkg": {
    "outputPath": "dist"
  },
  "engines": {
    "node": ">=22"
  }
}
